{
  "name": "controllami",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "test": "tsx --test tests/*.test.ts",
    "mock": "tsx mock/mockServer.ts",
    "typecheck": "tsc --noEmit",
    "build:apk": "expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-intent-launcher": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-media-library": "~58.0.13",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-tcp-socket": "^6.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
